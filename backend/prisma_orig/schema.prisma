generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id               Int           @id @default(autoincrement())
  institution_id   Int?
  transaction_type String?       @db.VarChar(20)
  category         String?       @db.VarChar(100)
  amount           Decimal       @db.Decimal(15, 2)
  description      String?
  transaction_date DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  institutions     institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admissions {
  id                    Int           @id @default(autoincrement())
  institution_id        Int?
  applicant_name        String        @db.VarChar(255)
  gender                String?       @db.VarChar(10)
  applied_date          DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  class_applied         String?       @db.VarChar(50)
  parent_name           String?       @db.VarChar(255)
  parent_phone          String?       @db.VarChar(20)
  email                 String?       @db.VarChar(255)
  address               String?
  status                String?       @default("PENDING") @db.VarChar(20)
  application_no        String?       @unique @db.VarChar(50)
  registration_fee_paid Boolean?      @default(false)
  remarks               String?
  created_at            DateTime?     @default(now()) @db.Timestamp(6)
  institutions          institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model announcements {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  title          String        @db.VarChar(255)
  content        String
  target_role    String?       @db.VarChar(50)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id                                 Int           @id @default(autoincrement())
  institution_id                     Int?
  student_id                         Int?
  date                               DateTime      @db.Date
  status                             String?       @db.VarChar(20)
  marked_by                          Int?
  institutions                       institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_attendance_marked_byTousers  users?        @relation("attendance_marked_byTousers", fields: [marked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_attendance_student_idTousers users?        @relation("attendance_student_idTousers", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, date])
}

model awards {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  user_id        Int?
  title          String        @db.VarChar(255)
  description    String?
  award_date     DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model book_issues {
  id          Int       @id @default(autoincrement())
  book_id     Int?
  user_id     Int?
  issue_date  DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date    DateTime  @db.Date
  return_date DateTime? @db.Date
  status      String?   @default("Issued") @db.VarChar(20)
  books       books?    @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model books {
  id               Int           @id @default(autoincrement())
  institution_id   Int?
  title            String        @db.VarChar(255)
  author           String?       @db.VarChar(255)
  isbn             String?       @db.VarChar(50)
  category         String?       @db.VarChar(100)
  total_copies     Int?          @default(1)
  available_copies Int?          @default(1)
  book_issues      book_issues[]
  institutions     institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model circulars {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  title          String    @db.VarChar(255)
  content        String?
  target_role    String?   @default("ALL") @db.VarChar(20)
  published_by   Int?
  publish_date   DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  expiry_date    DateTime? @db.Date
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

model classes {
  syllabuses      Syllabus[]
  lesson_plans    LessonPlan[]
  assignments     Assignment[]
  study_materials StudyMaterial[]
  id              Int             @id @default(autoincrement())
  institution_id  Int?
  name            String          @db.VarChar(50)
  section         String?         @db.VarChar(50)
  teacher_id      Int?
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  institutions    institutions?   @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?          @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  homework        homework[]
  timetables      timetables[]
  teacher_subjects teacher_subjects[]
}

model events {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  title          String        @db.VarChar(255)
  description    String?
  event_date     DateTime      @db.Date
  location       String?       @db.VarChar(255)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exam_results {
  id             Int       @id @default(autoincrement())
  exam_id        Int?
  student_id     Int?
  marks_obtained Decimal?  @db.Decimal(6, 2)
  grade          String?   @db.VarChar(5)
  remarks        String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@unique([exam_id, student_id])
}

model exams {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  name           String        @db.VarChar(255)
  date           DateTime      @db.Date
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  results        results[]
}

model fee_payments {
  id               Int       @id @default(autoincrement())
  institution_id   Int?
  student_id       Int?
  fee_structure_id Int?
  amount_paid      Decimal   @db.Decimal(12, 2)
  payment_date     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  payment_mode     String?   @default("CASH") @db.VarChar(50)
  transaction_id   String?   @db.VarChar(100)
  status           String?   @default("PAID") @db.VarChar(20)
  receipt_number   String?   @db.VarChar(100)
  remarks          String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
}

model fee_structures {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  class_id       Int?
  name           String    @db.VarChar(200)
  amount         Decimal   @db.Decimal(12, 2)
  frequency      String?   @default("ANNUAL") @db.VarChar(20)
  academic_year  String?   @default("2025-26") @db.VarChar(20)
  due_date       DateTime? @db.Date
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fees {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  student_id     Int?
  amount_due     Decimal       @db.Decimal(10, 2)
  amount_paid    Decimal?      @default(0) @db.Decimal(10, 2)
  status         String?       @db.VarChar(50)
  due_date       DateTime      @db.Date
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model gallery {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  title          String?       @db.VarChar(255)
  image_url      String        @db.VarChar(255)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model homework {
  id                   Int                    @id @default(autoincrement())
  institution_id       Int?
  class_id             Int?
  subject_id           Int?
  teacher_id           Int?
  title                String                 @db.VarChar(255)
  description          String?
  due_date             DateTime?              @db.Date
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  classes              classes?               @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  institutions         institutions?          @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects             subjects?              @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?                 @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homework_submissions homework_submissions[]
}

model homework_submissions {
  id           Int       @id @default(autoincrement())
  homework_id  Int?
  student_id   Int?
  content      String?
  file_url     String?   @db.VarChar(255)
  submitted_at DateTime? @default(now()) @db.Timestamp(6)
  grade        String?   @db.VarChar(10)
  feedback     String?
  homework     homework? @relation(fields: [homework_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?    @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model institutions {
  syllabuses        Syllabus[]
  lesson_plans      LessonPlan[]
  assignments       Assignment[]
  study_materials   StudyMaterial[]
  academic_events   AcademicEvent[]
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(255)
  subdomain         String          @unique @db.VarChar(100)
  subscription_plan String?         @default("basic") @db.VarChar(50)
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  email             String?         @unique @db.VarChar(255)
  phone             String?         @db.VarChar(20)
  address           String?
  plan              String?         @default("FREE") @db.VarChar(50)
  is_active         Boolean?        @default(true)
  accounts          accounts[]
  admissions        admissions[]
  announcements     announcements[]
  attendance        attendance[]
  awards            awards[]
  books             books[]
  classes           classes[]
  events            events[]
  exams             exams[]
  fees              fees[]
  gallery           gallery[]
  homework          homework[]
  leaves            leaves[]
  subjects          subjects[]
  transport         transport[]
  users             users[]
  teacher_subjects  teacher_subjects[]
  teacher_attendance teacher_attendance[]
  teacher_payroll    teacher_payroll[]
  activity_logs      activity_logs[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leaves {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  user_id        Int?
  leave_type     String        @db.VarChar(50)
  start_date     DateTime      @db.Date
  end_date       DateTime      @db.Date
  reason         String?
  status         String?       @default("Pending") @db.VarChar(20)
  applied_at     DateTime?     @default(now()) @db.Timestamp(6)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  title      String    @db.VarChar(255)
  message    String?
  type       String?   @default("INFO") @db.VarChar(50)
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model results {
  id         Int     @id @default(autoincrement())
  exam_id    Int?
  student_id Int?
  subject    String  @db.VarChar(100)
  marks      Decimal @db.Decimal(5, 2)
  grade      String? @db.VarChar(5)
  exams      exams?  @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_id, student_id, subject])
}

model student_transport {
  id          Int       @id @default(autoincrement())
  student_id  Int?      @unique
  route_id    Int?
  pickup_stop String?   @db.VarChar(200)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model students {
  user_id           Int    @id
  enrollment_number String @db.VarChar(100)
  class_name        String @db.VarChar(50)
  section           String @db.VarChar(50)
  institution_id    Int?
  users             users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subjects {
  syllabuses      Syllabus[]
  lesson_plans    LessonPlan[]
  assignments     Assignment[]
  study_materials StudyMaterial[]
  id              Int             @id @default(autoincrement())
  institution_id  Int?
  name            String          @db.VarChar(100)
  code            String?         @db.VarChar(50)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  homework        homework[]
  institutions    institutions?   @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  timetables      timetables[]
  teacher_subjects teacher_subjects[]
}

model teachers {
  user_id          Int       @id
  employee_id      String    @db.VarChar(100)
  department       String?   @db.VarChar(100)
  institution_id   Int?
  photo_url        String?   @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  qualification    String?   @db.VarChar(255)
  experience_years Int?      
  joining_date     DateTime? @db.Date
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model timetables {
  id          Int       @id @default(autoincrement())
  class_id    Int?
  subject_id  Int?
  teacher_id  Int?
  day_of_week String    @db.VarChar(20)
  start_time  DateTime  @db.Time(6)
  end_time    DateTime  @db.Time(6)
  room_number String?   @db.VarChar(50)
  classes     classes?  @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects    subjects? @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model transport {
  id             Int           @id @default(autoincrement())
  institution_id Int?
  route_name     String        @db.VarChar(255)
  vehicle_number String?       @db.VarChar(50)
  driver_name    String?       @db.VarChar(100)
  driver_phone   String?       @db.VarChar(20)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model transport_routes {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  route_name     String    @db.VarChar(200)
  driver_name    String?   @db.VarChar(200)
  driver_phone   String?   @db.VarChar(20)
  vehicle_number String?   @db.VarChar(50)
  capacity       Int?
  fee_per_month  Decimal?  @db.Decimal(10, 2)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  syllabuses                              Syllabus[]
  lesson_plans                            LessonPlan[]
  assignments_given                       Assignment[]           @relation("TeacherAssignments")
  assignment_submissions                  AssignmentSubmission[] @relation("StudentSubmissions")
  study_materials                         StudyMaterial[]
  id                                      Int                    @id @default(autoincrement())
  institution_id                          Int?
  role                                    String                 @db.VarChar(50)
  name                                    String                 @db.VarChar(255)
  email                                   String                 @unique @db.VarChar(255)
  password_hash                           String                 @db.VarChar(255)
  created_at                              DateTime?              @default(now()) @db.Timestamp(6)
  attendance_attendance_marked_byTousers  attendance[]           @relation("attendance_marked_byTousers")
  attendance_attendance_student_idTousers attendance[]           @relation("attendance_student_idTousers")
  awards                                  awards[]
  book_issues                             book_issues[]
  classes                                 classes[]
  fees                                    fees[]
  homework                                homework[]
  homework_submissions                    homework_submissions[]
  leaves                                  leaves[]
  results                                 results[]
  students                                students?
  teachers                                teachers?
  timetables                              timetables[]
  institutions                            institutions?          @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  teacher_subjects                        teacher_subjects[]
  teacher_attendance_recorded             teacher_attendance[]   @relation("TeacherAttendanceTeacher")
  teacher_attendance_marked               teacher_attendance[]   @relation("TeacherAttendanceMarker")
  teacher_payroll                         teacher_payroll[]
  activity_logs                           activity_logs[]
}

model Syllabus {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  class_id       Int?
  subject_id     Int?
  assigned_to    Int?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  classes      classes?      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects     subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  institutions institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  users        users?        @relation(fields: [assigned_to], references: [id], onDelete: SetNull)
  topics       Topic[]
}

model Topic {
  id                Int       @id @default(autoincrement())
  syllabus_id       Int?
  title             String    @db.VarChar(255)
  description       String?
  completion_status Boolean   @default(false)
  completion_date   DateTime? @db.Date
  created_at        DateTime? @default(now()) @db.Timestamp(6)

  syllabus Syllabus? @relation(fields: [syllabus_id], references: [id], onDelete: Cascade)
}

model LessonPlan {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  class_id       Int?
  subject_id     Int?
  teacher_id     Int?
  topic          String    @db.VarChar(255)
  date           DateTime  @db.Date
  homework       String?
  materials_used String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  classes      classes?      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects     subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  users        users?        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  institutions institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

model Assignment {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  class_id       Int?
  subject_id     Int?
  teacher_id     Int?
  title          String    @db.VarChar(255)
  description    String?
  file_url       String?   @db.VarChar(255)
  due_date       DateTime  @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  classes      classes?      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects     subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  users        users?        @relation("TeacherAssignments", fields: [teacher_id], references: [id], onDelete: Cascade)
  institutions institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id            Int       @id @default(autoincrement())
  assignment_id Int?
  student_id    Int?
  file_url      String?   @db.VarChar(255)
  student_note  String?
  submitted_at  DateTime? @default(now()) @db.Timestamp(6)
  grade         String?   @db.VarChar(20)
  feedback      String?

  assignment Assignment? @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  users      users?      @relation("StudentSubmissions", fields: [student_id], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  class_id       Int?
  subject_id     Int?
  teacher_id     Int?
  title          String    @db.VarChar(255)
  description    String?
  file_type      String?   @db.VarChar(50)
  file_url       String    @db.VarChar(255)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  classes      classes?      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects     subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  users        users?        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  institutions institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

model AcademicEvent {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  title          String    @db.VarChar(255)
  event_type     String    @db.VarChar(50)
  start_date     DateTime  @db.Date
  end_date       DateTime? @db.Date
  description    String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  institutions institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

model teacher_subjects {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  teacher_id     Int?
  subject_id     Int?
  class_id       Int?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  
  users          users?        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  subjects       subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  classes        classes?      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}

model teacher_attendance {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  teacher_id     Int?
  date           DateTime  @db.Date
  status         String    @db.VarChar(20) // Present, Absent, Half-Day, Leave
  remarks        String?
  marked_by      Int?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  users_teacher  users?        @relation("TeacherAttendanceTeacher", fields: [teacher_id], references: [id], onDelete: Cascade)
  users_marker   users?        @relation("TeacherAttendanceMarker", fields: [marked_by], references: [id], onDelete: SetNull)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, date])
}

model teacher_payroll {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  teacher_id     Int?
  month          Int
  year           Int
  basic_salary   Decimal   @db.Decimal(10, 2)
  allowances     Decimal?  @default(0) @db.Decimal(10, 2)
  deductions     Decimal?  @default(0) @db.Decimal(10, 2)
  net_salary     Decimal   @db.Decimal(10, 2)
  payment_date   DateTime? @db.Date
  status         String    @default("PENDING") @db.VarChar(20) // PENDING, PAID
  remarks        String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  users          users?        @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, month, year])
}

model activity_logs {
  id             Int       @id @default(autoincrement())
  institution_id Int?
  user_id        Int?
  action         String    @db.VarChar(255)
  details        String?
  type           String    @db.VarChar(50) // ADMISSION, FEE, CIRCULAR, LEAVE, SYSTEM
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  users          users?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: Cascade)
}
