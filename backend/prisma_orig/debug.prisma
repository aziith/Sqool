generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id Int @id @default(autoincrement())
  institution_id Int?
  transaction_type String?
  category String?
  amount Decimal
  description String?
  transaction_date DateTime? @default(dbgenerated("CURRENT_DATE"))
}
